{
  "model": "Graph WaveNet",
  "source_rows": 2280,
  "historical_rows": 2098,
  "forecast_tail_rows_excluded": 182,
  "history_start_date": "2019-01-03",
  "history_end_date": "2024-09-30",
  "train_ratio": 0.8,
  "validation_ratio": 0.1,
  "test_ratio": 0.1,
  "input_window": 12,
